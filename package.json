{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "User registration, login and password reset microservice",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tenant:key": "tsx scripts/create-tenant-key.ts",
    "tenant:migrate": "tsx --env-file-if-exists=.env scripts/migrate-legacy-to-tenant.ts",
    "admin:key": "tsx scripts/create-admin-key.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.17",
    "mongoose": "^9.12.3",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
