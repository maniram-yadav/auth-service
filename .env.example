# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---- Database: choose the backend ----
# mongodb  -> uses MONGODB_URI
# postgres -> uses DATABASE_URL (tables are created automatically on startup)
DB_DRIVER=mongodb

MONGODB_URI=mongodb://localhost:27017/auth_service

DATABASE_URL=postgres://auth_service:change-me@localhost:5432/auth_service
# Schema for the tenant-prefixed tables (TENANT_ISOLATION=collection)
PG_SCHEMA=public
PG_POOL_MAX=10
# true = require TLS with certificate verification (managed Postgres: RDS, Cloud SQL, Azure, …)
PG_SSL=false
# Minutes between deletions of expired refresh tokens / reset codes (MongoDB uses TTL indexes instead)
PG_PURGE_INTERVAL_MINUTES=60

# Generate each with: openssl rand -base64 48   (use different values!)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
RESET_CODE_SECRET=change-me-to-another-long-random-string-32-chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=call-blocker-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RESET_CODE_TTL_MINUTES=15
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---- Multi-tenancy (see docs/MULTI_TENANCY.md) ----
# Each app / website is a tenant identified by its API key (header X-API-Key).
# Copy tenants.example.json to tenants.json and generate keys with: npm run tenant:key -- <tenant_id>
TENANTS_FILE=./tenants.json
# TENANTS_JSON={"tenants":[...]}          (alternative to TENANTS_FILE, e.g. from a secret manager)
# collection = <tenant>_users etc. in one database (MongoDB) / one schema (PostgreSQL)
# database   = one database per tenant (MongoDB) / one schema per tenant (PostgreSQL)
TENANT_ISOLATION=collection
TENANT_DB_PREFIX=auth_

# Extra CORS origins (tenant allowedOrigins are added automatically).
CORS_ORIGINS=
# Number of reverse proxies / load balancers in front of the service (for correct client IPs)
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# Mail: "gmail" (required in production) or "console" (dev: codes are printed to the log)
MAIL_TRANSPORT=console
APP_NAME=Call Blocker
# MAIL_FROM="Call Blocker <no-reply@yourdomain.com>"   (must be the Gmail account or a verified alias)
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
